{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zorter",
  "version": "../package.json",
  "identifier": "com.zorter.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Zorter",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 660,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0a0e1a",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Zorter",
    "category": "Productivity",
    "shortDescription": "Local AI file organizer",
    "longDescription": "Understand, organize and search your images with local AI models running on Ollama.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "copyright": "Copyright © 2026 Zorter contributors"
  },
  "mainBinaryName": "zorter"
}
